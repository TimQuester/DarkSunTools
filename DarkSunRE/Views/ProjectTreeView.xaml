<UserControl x:Class="DarkSunRE.Views.ProjectTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DarkSunRE.Models"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="200">
    <UserControl.Resources>
        <Style x:Key="GenerateFileMenuItemStyle" TargetType="MenuItem"/>
        <Style x:Key="SaveAllJsonsMenuItemStyle" TargetType="MenuItem"/>
        <Style x:Key="LoadAllJsonsMenuItemStyle" TargetType="MenuItem"/>
        <ContextMenu x:Key="GffFileContextMenu">
            <MenuItem Header="Generate new file" Style="{StaticResource GenerateFileMenuItemStyle}"
                      Command="{Binding DataContext.GenerateNewFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
              CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="Save all JSONs" Style="{StaticResource SaveAllJsonsMenuItemStyle}"
                    Command="{Binding DataContext.SaveAllJsonsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                    CommandParameter="{Binding}"/>
            <MenuItem Header="Load all JSONs" Style="{StaticResource LoadAllJsonsMenuItemStyle}"
                    Command="{Binding DataContext.LoadAllJsonsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                    CommandParameter="{Binding}"/>
        </ContextMenu>
    </UserControl.Resources>
    <DockPanel>
        <!-- Панель инструментов дерева -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Expand All" Command="{Binding ExpandAllCommand}"/>
                <Button Content="Collapse All" Command="{Binding CollapseAllCommand}"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Панель фильтров -->
        <Expander DockPanel.Dock="Top" Header="Filters" IsExpanded="False">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Button Content="All" Command="{Binding SelectAllFiltersCommand}" Width="40" Margin="0,0,5,0"/>
                    <Button Content="None" Command="{Binding DeselectAllFiltersCommand}" Width="40"/>
                </StackPanel>
                <CheckBox Content="Images" IsChecked="{Binding ShowImages}" Margin="5"/>
                <CheckBox Content="Palettes" IsChecked="{Binding ShowPalettes}" Margin="5"/>
                <CheckBox Content="Fonts" IsChecked="{Binding ShowFonts}" Margin="5"/>
                <CheckBox Content="Texts" IsChecked="{Binding ShowTexts}" Margin="5"/>
                <CheckBox Content="Scripts" IsChecked="{Binding ShowScripts}" Margin="5"/>
                <CheckBox Content="Sounds" IsChecked="{Binding ShowSounds}" Margin="5"/>
                <CheckBox Content="Music" IsChecked="{Binding ShowMusic}" Margin="5"/>
                <CheckBox Content="Dialogs" IsChecked="{Binding ShowDialogs}" Margin="5"/>
                <CheckBox Content="Items" IsChecked="{Binding ShowItems}" Margin="5"/>
                <CheckBox Content="Characters" IsChecked="{Binding ShowCharacters}" Margin="5"/>
                <CheckBox Content="Maps" IsChecked="{Binding ShowMaps}" Margin="5"/>
                <CheckBox Content="Animations" IsChecked="{Binding ShowAnimations}" Margin="5"/>
                <CheckBox Content="Raw Data" IsChecked="{Binding ShowRawData}" Margin="5"/>
                <CheckBox Content="Animation Controls" IsChecked="{Binding ShowAnimationControls}" Margin="5"/>
                <CheckBox Content="Names" IsChecked="{Binding ShowNames}" Margin="5"/>
                <CheckBox Content="Unknown" IsChecked="{Binding ShowUnknown}" Margin="5"/>
            </StackPanel>
        </Expander>

        <!-- Дерево проекта -->
        <TreeView ItemsSource="{Binding FilteredRootNodes}" 
                  SelectedItemChanged="TreeView_SelectedItemChanged"
                  MouseDoubleClick="TreeView_MouseDoubleClick">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ItemType}" Value="GffFile">
                            <Setter Property="ContextMenu" Value="{StaticResource GffFileContextMenu}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type local:ProjectNode}" 
                                          ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding Name}"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>
    </DockPanel>
</UserControl>
