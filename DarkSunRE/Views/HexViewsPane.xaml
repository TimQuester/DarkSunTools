<UserControl x:Class="DarkSunRE.Views.HexViewsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hexview="clr-namespace:WpfHexaEditor;assembly=WPFHexaEditor"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>
        <hexview:HexEditor x:Name="hexViewer1" ReadOnlyMode="True" Grid.Column="0"/>
        <hexview:HexEditor x:Name="hexViewer2" ReadOnlyMode="True" Grid.Column="1"/>
    </Grid>
</UserControl>

    