<UserControl x:Class="DarkSunRE.Views.GplDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:DarkSunRE.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="VerticalStringsTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding OriginalString}"
                             Grid.Column="0" Grid.Row="0"
                             FontWeight="Bold"
                             TextWrapping="WrapWithOverflow"
                             MaxWidth="600"/>
                <TextBlock Text="{Binding OriginalSize}" Padding="2" Grid.Column="1" Grid.Row="0"/>
                <TextBox Text="{Binding NewString, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Column="0" Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="1"
                             Padding="2,0" TextWrapping="WrapWithOverflow"
                             MaxWidth="600"
                             ToolTip="{Binding ValidationError}"/>
                <TextBlock Text="{Binding LengthDisplay}"
                           Padding="2" Grid.Column="1" Grid.Row="1"
                           ToolTip="Current length / maximum length">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                    <Setter Property="Foreground" Value="#FFB00020" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <Style x:Key="StringRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                    <Setter Property="Background" Value="#FFFFE4E4" />
                    <Setter Property="ToolTip" Value="{Binding ValidationError}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFFF4CE"
                BorderBrush="#FFE0B84C"
                BorderThickness="0,0,0,1"
                Padding="8,6"
                Visibility="{Binding HasValidationErrors, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ValidationSummary}"
                       TextWrapping="Wrap"
                       Foreground="#FF6B4E00" />
        </Border>

        <DataGrid Grid.Row="1"
                  x:Name="StringsGrid"
                  ItemsSource="{Binding Strings}"
                  SelectedItem="{Binding SelectedString, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  RowStyle="{StaticResource StringRowStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding StringNumber}" />
                <DataGridTextColumn Header="Start" Binding="{Binding StartPosition}" />
                <DataGridTextColumn Header="End" Binding="{Binding EndPosition}" />
                <DataGridTemplateColumn Header="Strings" CellTemplate="{StaticResource VerticalStringsTemplate}" Width="630"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
