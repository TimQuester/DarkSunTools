<UserControl x:Class="DarkSunRE.Views.TextResourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Original game text (no transliteration)" FontWeight="Bold" Margin="2,0,0,4"/>
            <TextBlock Grid.Column="2" Text="Translation (with transliteration table)" FontWeight="Bold" Margin="2,0,0,4"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding OriginalGameText, Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     Background="#FFF4F4F4"
                     FontFamily="Consolas"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"/>
            <TextBox Grid.Column="2"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     FontFamily="Consolas"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <TextBlock Text="{Binding ValidationError}" Foreground="Firebrick" VerticalAlignment="Center" Margin="6,0" />
            <Button Content="Reload" Command="{Binding ReloadCommand}" Margin="4" Padding="12,4" />
            <Button Content="Save" Command="{Binding SaveCommand}" Margin="4" Padding="12,4" />
        </StackPanel>
    </Grid>
</UserControl>
