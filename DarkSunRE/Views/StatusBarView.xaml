<UserControl x:Class="DarkSunRE.Views.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DarkSunRE.Converters">

    <UserControl.Resources>
        <conv:StatusMessageTypeToBrushConverter x:Key="StatusColorConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:ProgressVisibilityConverter x:Key="ProgressVisibilityConverter"/>
    </UserControl.Resources>

    <Border Background="{Binding MessageType, Converter={StaticResource StatusColorConverter}}"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Основное сообщение -->
            <TextBlock Text="{Binding Message}" 
                       Margin="10,5"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <!-- Progress Bar -->
            <ProgressBar Grid.Column="1" 
                        Value="{Binding Progress}"
                        IsIndeterminate="{Binding IsIndeterminate}"
                        Width="100" Height="16" Margin="5"
                        Visibility="{Binding MessageType, Converter={StaticResource ProgressVisibilityConverter}}"/>

            <!-- Кнопки действий -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="5">
                <Button Content="✕" Command="{Binding ClearCommand}" 
                        ToolTip="Clear message" Width="20" Height="20"/>
                <Button Content="📋" Command="{Binding ShowHistoryCommand}"
                        ToolTip="Show message history" Width="20" Height="20"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
