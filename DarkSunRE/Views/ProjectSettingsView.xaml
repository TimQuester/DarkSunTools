<Window x:Class="DarkSunRE.Views.ProjectSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Settings" Height="379" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Original Game Path:" Grid.Row="0" FontWeight="Bold"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding OriginalGamePath}" IsReadOnly="True" Margin="5"/>
            <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseOriginalCommand}" Margin="5"/>
        </Grid>

        <TextBlock Text="Modified Game Path:" Grid.Row="2" FontWeight="Bold" Margin="0,8,0,0"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding ModifiedGamePath}" IsReadOnly="True" Margin="5"/>
            <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseModifiedCommand}" Margin="5"/>
        </Grid>

        <TextBlock Text="JSON Folder Path:" Grid.Row="4" FontWeight="Bold" Margin="0,8,0,0"/>
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding JsonFolderPath}" IsReadOnly="True" Margin="5"/>
            <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseJsonCommand}" Margin="5"/>
        </Grid>

        <TextBlock Text="Transliteration table ('from=to' separated by ';'):" Grid.Row="6" FontWeight="Bold" Margin="0,8,0,0"/>
        <TextBox Grid.Row="7" Margin="0,4,0,0" Text="{Binding TransliterationTableText}" AcceptsReturn="False" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0" Height="32" VerticalAlignment="Bottom">
            <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" Margin="6"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="6"/>
        </StackPanel>
    </Grid>
</Window>