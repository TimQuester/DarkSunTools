<Window x:Class="DarkSunRE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DarkSunRE"
        xmlns:models="clr-namespace:DarkSunRE.Models"
        xmlns:avalondock="http://schemas.xceed.com/wpf/xaml/avalondock"
        xmlns:hexview="clr-namespace:WpfHexaEditor;assembly=WPFHexaEditor"        
        xmlns:controls="clr-namespace:DarkSunRE.Controls"
        mc:Ignorable="d"
        Title="MainWindow" Width="1200" Height="1024">
    <Window.Resources>
        <DataTemplate x:Key="VerticalStringsTemplate">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding OriginalString}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding OriginalSize}" Padding="2"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding NewString, UpdateSourceTrigger=PropertyChanged}"                      
                     Background="Transparent"
                     BorderThickness="1"
                     Padding="2,0"/>
                    <TextBlock Text="{Binding NewSize, UpdateSourceTrigger=PropertyChanged}" Padding="2"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
            <Menu>
                <MenuItem Header="File">
                    <MenuItem Header="Open folder" Click="MenuItem_Click"/>
                </MenuItem>
            </Menu>
            <ToolBar>
                <Button Click="MenuItem_Click" BorderBrush="Black" BorderThickness ="1">Open folder</Button>
                <Button Click="UpdateGPL_Click" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left">Update GPL</Button>
                <Button Click="SaveNewGPL_Click" BorderBrush="Black" BorderThickness="1" Content="Save new GPL"/>
                <Button Click="SaveJSONGPL_Click" BorderBrush="Black" BorderThickness="1" Content="Save JSON GPL"/>
                <Button Click="LoadJSONGPL_Click" BorderBrush="Black" BorderThickness="1" Content="Load JSON GPL"/>
            </ToolBar>
        </StackPanel>
        <avalondock:DockingManager Grid.Row="1" Grid.ColumnSpan="3">
            <avalondock:LayoutRoot>
                <avalondock:LayoutPanel Orientation="Horizontal">
                    <avalondock:LayoutAnchorablePane>
                        <avalondock:LayoutAnchorable Title="Files">
                            <TreeView x:Name="FileTree" Width="auto">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <EventSetter Event="MouseDoubleClick" Handler="TreeViewItem_MouseDoubleClick"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </avalondock:LayoutAnchorable>
                    </avalondock:LayoutAnchorablePane>
                    <avalondock:LayoutPanel Orientation="Vertical">
                        <avalondock:LayoutDocumentPane x:Name="layoutDocumentPane"/>
                        <avalondock:LayoutAnchorablePane>
                            <avalondock:LayoutAnchorable Title="Hex View">
                                <controls:HexViewsPane x:Name="hvp"/>
                            </avalondock:LayoutAnchorable>
                        </avalondock:LayoutAnchorablePane>
                    </avalondock:LayoutPanel>
                </avalondock:LayoutPanel>
            </avalondock:LayoutRoot>
        </avalondock:DockingManager>
    </Grid>
</Window>
