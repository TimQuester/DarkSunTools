<UserControl x:Class="DarkSunRE.Views.AnimationResourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" VerticalAlignment="Center">
            <Button Content="{Binding PlayPauseText}" Command="{Binding PlayPauseCommand}" Width="60" Margin="0,0,5,0"/>
            <Button Content="◀" Command="{Binding PreviousFrameCommand}" Width="28" Margin="0,0,2,0"/>
            <Button Content="▶" Command="{Binding NextFrameCommand}" Width="28" Margin="0,0,8,0"/>
            <Slider Width="240" Minimum="0"
                    Maximum="{Binding LastFrameIndex}"
                    Value="{Binding CurrentFrameIndex, Mode=TwoWay}"
                    IsSnapToTickEnabled="True" TickFrequency="1"
                    VerticalAlignment="Center"/>
            <TextBlock Text="{Binding FrameLabel}" VerticalAlignment="Center" Margin="8,0,12,0" MinWidth="70"/>

            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0"/>

            <TextBlock Text="Palette:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox ItemsSource="{Binding AvailablePalettes}"
                      SelectedItem="{Binding SelectedPalette, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      Width="170"
                      Margin="0,0,10,0"/>

            <Button Content="-" Command="{Binding ZoomOutCommand}" Width="25" Height="25" Margin="5,0"/>
            <TextBlock Text="{Binding ScalePercentage, StringFormat='{}{0}%'}" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <Button Content="+" Command="{Binding ZoomInCommand}" Width="25" Height="25" Margin="0,0,5,0"/>
            <Button Content="100%" Command="{Binding ResetZoomCommand}" Width="40" Height="25"/>
        </StackPanel>

        <Border Grid.Row="1" Background="Black" ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Image Source="{Binding ImageSource}"
                       Stretch="None"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
